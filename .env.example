# Telegram Bot (get from @BotFather)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Your Telegram user ID (get from @userinfobot)
# Comma-separated for multiple users
ALLOWED_USER_IDS=123456789

# Default AI agent to use
DEFAULT_AGENT=opencode

# Default project directory for agent tasks
DEFAULT_PROJECT_DIR=/home/you/your-project

# Agent command templates (JSON)
# {prompt} and {project_dir} are replaced at runtime
AGENT_COMMANDS={"opencode": "cd {project_dir} && echo {prompt} | opencode", "aider": "cd {project_dir} && aider --message {prompt}"}

# Task timeout in seconds (default: 30 minutes)
TASK_TIMEOUT_SECONDS=1800

# SQLite database path
DB_PATH=data/taskpilot.db
