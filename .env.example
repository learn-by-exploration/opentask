# Telegram Bot (get from @BotFather)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Your Telegram user ID (get from @userinfobot)
# Comma-separated for multiple users
ALLOWED_USER_IDS=123456789

# Default AI agent to use
DEFAULT_AGENT=opencode

# Default project directory for agent tasks
DEFAULT_PROJECT_DIR=/home/you/your-project

# Allowed project directories (comma-separated)
ALLOWED_PROJECT_DIRS=/home/you/ai,/home/you/repos,/home/you/projects

# Agent command templates (JSON)
# {prompt} and {project_dir} are replaced at runtime (shell-escaped)
AGENT_COMMANDS={"opencode": "opencode -p {prompt} --dir {project_dir}", "aider": "aider --message {prompt} --yes --no-git"}

# Task timeout in seconds (default: 30 minutes)
TASK_TIMEOUT_SECONDS=1800

# Maximum pending + running tasks
MAX_QUEUE_SIZE=20

# Seconds between progress notifications while a task runs
PROGRESS_INTERVAL_SECONDS=30

# SQLite database path
DB_PATH=data/taskpilot.db

# Web dashboard (requires: pip install .[web])
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8095
# Optional bearer token for dashboard auth (empty = no auth)
DASHBOARD_TOKEN=
